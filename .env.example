# Environment Configuration for Keystroke Dynamics Project
# Copy this to .env and set your own values

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_to_a_long_random_string_in_production
DEBUG=False

# Database Configuration
DATABASE_URI=sqlite:///keystroke_db.db
# For PostgreSQL: DATABASE_URI=postgresql://user:password@localhost:5432/keystroke_db

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Security Configuration
PBKDF2_SALT_LENGTH=16
SESSION_TIMEOUT_DAYS=7
PASSWORD_MIN_LENGTH=8

# Continuous Authentication Configuration
CONTINUOUS_AUTH_CHECK_INTERVAL=300
CONTINUOUS_AUTH_ANOMALY_THRESHOLD=75.0

# Model Configuration
RF_MODEL_PATH=outputs/models/rf_stress_model.pkl
XGB_MODEL_PATH=outputs/models/xgb_stress_model.pkl
SCALER_PATH=outputs/models/scaler.pkl

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
